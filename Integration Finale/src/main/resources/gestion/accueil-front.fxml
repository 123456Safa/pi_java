<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<VBox xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AccueilFrontController" spacing="0" stylesheets="@AccueilFront.css">

    <!-- ═══ TOP BAR VERTE ═══ -->
    <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="10">
        <Label text="📖  BLOG" styleClass="top-bar-link" onMouseClicked="#showBlog"
               style="-fx-cursor: hand;" />
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="✦  LIVRAISON GRATUITE DÈS 99 DT D'ACHAT !!" styleClass="top-bar-promo"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Contact" styleClass="top-bar-link"/>
    </HBox>

    <!-- ═══ HEADER BLANC ═══ -->
    <HBox styleClass="main-header" alignment="CENTER" spacing="20">
        <Label text="Pharmax." styleClass="logo-text"/>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox styleClass="search-wrapper" alignment="CENTER" spacing="0" HBox.hgrow="ALWAYS">
            <TextField fx:id="searchNomField"
                       promptText="Cherchez le produit qui vous convient"
                       styleClass="search-field" HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnRechercher" text="Rechercher" styleClass="btn-search" onAction="#onRechercherProduit"/>
        </HBox>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox spacing="12" alignment="CENTER">
            <Button fx:id="btnProfil" text="👤  Mon Profil" styleClass="btn-header-action" onAction="#showUserProfile"/>
            <Button fx:id="btnAdminDashboard" text="⚙️ Dashboard Admin" styleClass="btn-header-action" onAction="#goToBackOffice" managed="false" visible="false" style="-fx-text-fill: #1e293b; -fx-border-color: #cbd5e1; -fx-background-color: #f1f5f9;" />
            <Button fx:id="btnSignOut" text="🚪 Déconnexion" styleClass="btn-header-action" onAction="#logout" style="-fx-text-fill: #ef4444; -fx-border-color: transparent;" />
            <StackPane>
                <Button text="🔔" styleClass="btn-header-action" onAction="#showNotifications"
                        style="-fx-background-color: transparent; -fx-font-size: 16; -fx-cursor: hand;"/>
                <Label fx:id="notifBadge" text="0" StackPane.alignment="TOP_RIGHT"
                       visible="false" managed="false"
                       style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-size: 9;
                              -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 2 4; -fx-min-width: 16;"/>
            </StackPane>
            <StackPane>
                <Button fx:id="btnPanier" text="🛒  Panier" styleClass="btn-header-panier" onAction="#showPanier"/>
                <Label fx:id="panierBadge" text="0" StackPane.alignment="TOP_RIGHT"
                       visible="false" managed="false"
                       style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-size: 9;
                              -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 2 4; -fx-min-width: 16;"/>
            </StackPane>
        </HBox>
    </HBox>

    <!-- ═══ NAV DORÉE ═══ -->
    <HBox styleClass="nav-bar" alignment="CENTER_LEFT" spacing="0">
        <Label fx:id="navPromos" text="Promos" styleClass="nav-item"/>
        <Label fx:id="navNouveautes" text="Nouveautés" styleClass="nav-item"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Blog" styleClass="nav-item" onMouseClicked="#showBlog"
               style="-fx-cursor: hand;"/>
        <Label text="Mes Commandes" styleClass="nav-item" onMouseClicked="#showHistorique"
               style="-fx-cursor: hand;"/>
        <Label text="Réclamations" styleClass="nav-item" onMouseClicked="#showReclamations"
               style="-fx-cursor: hand;"/>
    </HBox>

    <!-- ═══ SOUS-NAV (filled dynamically from DB categories) ═══ -->
    <HBox fx:id="sub_nav" styleClass="sub-nav" alignment="CENTER_LEFT" spacing="0">
    </HBox>

    <!-- ═══ ZONE DE CONTENU DYNAMIQUE ═══ -->
    <StackPane fx:id="contentStack" VBox.vgrow="ALWAYS">

        <!-- VUE ACCUEIL (Hero + Produits) -->
        <VBox fx:id="homeContainer" spacing="0">
            <!-- ═══ HERO BANNER ═══ -->
            <StackPane styleClass="hero-banner" prefHeight="260" minHeight="240">
                <HBox alignment="CENTER" spacing="0">
                    <Button text="❮" styleClass="hero-arrow-btn"/>
                    <VBox alignment="CENTER" spacing="18" HBox.hgrow="ALWAYS" styleClass="hero-content">
                        <Label text="🌿  Votre santé, notre priorité" styleClass="hero-title"/>
                        <Label text="Découvrez notre sélection de produits pharmaceutiques &amp; bien-être"
                               styleClass="hero-subtitle" wrapText="true"/>
                        <Button text="Découvrir maintenant  →" styleClass="hero-cta-btn"/>
                    </VBox>
                    <Button text="❯" styleClass="hero-arrow-btn"/>
                </HBox>
            </StackPane>

            <!-- ═══ CONTENU SCROLLABLE ═══ -->
            <ScrollPane fitToWidth="true" styleClass="content-scroll" VBox.vgrow="ALWAYS">
                <VBox spacing="0" styleClass="scroll-content">

                    <!-- HOT DEAL BAR + FILTRES -->
                    <HBox styleClass="hot-deal-bar" alignment="CENTER_LEFT" spacing="10">
                        <Label text="👍  Hot deal" styleClass="hot-deal-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Catégorie :" styleClass="filter-label-inline"/>
                        <ComboBox fx:id="categorieComboBox" promptText="Toutes" styleClass="filter-combo-inline" prefWidth="135"/>
                        <TextField fx:id="prixMinField" promptText="Prix min" styleClass="filter-field-inline" prefWidth="80"/>
                        <TextField fx:id="prixMaxField" promptText="Prix max" styleClass="filter-field-inline" prefWidth="80"/>
                        <Button fx:id="btnReinitialiser" text="✕" styleClass="btn-reset-inline" onAction="#onReinitialiser"/>
                        <Separator orientation="VERTICAL" styleClass="bar-sep"/>
                        <Button text="◀  Précédent" styleClass="btn-nav-prev"/>
                        <Button text="Suivant  ▶" styleClass="btn-nav-next"/>
                    </HBox>

                    <!-- PRODUITS DYNAMIQUES -->
                    <FlowPane fx:id="vboxProduitsAccueil" hgap="16" vgap="16"
                              styleClass="products-flow" alignment="TOP_LEFT"/>

                    <!-- ═══ NOS TOP PROMOS ═══ -->
                    <VBox styleClass="section-block" spacing="14">
                        <Label text="Nos top promos" styleClass="section-heading"/>
                        <FlowPane fx:id="flowPaneTopPromos" hgap="16" vgap="16" styleClass="products-flow" alignment="TOP_LEFT"/>
                    </VBox>

                </VBox>
            </ScrollPane>
        </VBox>
    </StackPane>
</VBox>
