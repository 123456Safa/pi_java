<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.GestionProduitDetailController"
            stylesheets="@produitdetail.css"
            style="-fx-background-color: #f4f6fb;">

    <!-- ═══ HEADER ═══ -->
    <top>
        <VBox styleClass="form-header" spacing="4">
            <Label fx:id="lblHeader" styleClass="header-label" text="Détails du Produit"/>
            <Label text="Informations complètes sur le produit sélectionné" styleClass="header-subtitle"/>
        </VBox>
    </top>

    <!-- ═══ CONTENU ═══ -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox spacing="20" styleClass="detail-container" style="-fx-padding: 28;">

                <HBox spacing="24" alignment="TOP_LEFT">

                    <!-- INFO CARD -->
                    <VBox spacing="16" styleClass="detail-section" HBox.hgrow="ALWAYS">
                        <Label text="📋  Informations générales"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #5856d6;"/>

                        <GridPane styleClass="info-grid" hgap="16" vgap="14">
                            <columnConstraints>
                                <ColumnConstraints prefWidth="140"/>
                                <ColumnConstraints prefWidth="200" hgrow="ALWAYS"/>
                            </columnConstraints>

                            <Label styleClass="field-label" text="Nom :"
                                   GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <Label fx:id="lblNom" styleClass="field-value"
                                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                            <Label styleClass="field-label" text="Description :"
                                   GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <Label fx:id="lblDescription" styleClass="field-value" wrapText="true"
                                   GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                            <Label styleClass="field-label" text="Prix :"
                                   GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                            <Label fx:id="lblPrix" styleClass="field-value"
                                   style="-fx-text-fill: #ffb300; -fx-font-weight: bold;"
                                   GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                            <Label styleClass="field-label" text="Quantité :"
                                   GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                            <Label fx:id="lblQuantite" styleClass="field-value"
                                   GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                            <Label styleClass="field-label" text="Statut :"
                                   GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                            <Label fx:id="lblStatut" styleClass="field-value"
                                   GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                            <Label styleClass="field-label" text="Catégorie :"
                                   GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                            <Label fx:id="lblCategorie" styleClass="field-value"
                                   GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                            <Label styleClass="field-label" text="Expiration :"
                                   GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                            <Label fx:id="lblDateExpiration" styleClass="field-value"
                                   GridPane.columnIndex="1" GridPane.rowIndex="6"/>

                            <Label styleClass="field-label" text="Prix Final :"
                                   GridPane.columnIndex="0" GridPane.rowIndex="7"/>
                            <Label fx:id="lblPrixFinal" styleClass="field-value"
                                   style="-fx-text-fill: #2ecc71; -fx-font-weight: bold;"
                                   GridPane.columnIndex="1" GridPane.rowIndex="7"/>

                            <Label styleClass="field-label" text="Code Promo :"
                                   GridPane.columnIndex="0" GridPane.rowIndex="8"/>
                            <Label fx:id="lblPromoCode" styleClass="field-value"
                                   style="-fx-text-fill: #e67e22; -fx-font-weight: bold;"
                                   GridPane.columnIndex="1" GridPane.rowIndex="8"/>

                            <Label styleClass="field-label" text="Réduction :"
                                   GridPane.columnIndex="0" GridPane.rowIndex="9"/>
                            <Label fx:id="lblDiscount" styleClass="field-value"
                                   style="-fx-text-fill: #e74c3c; -fx-font-weight: bold;"
                                   GridPane.columnIndex="1" GridPane.rowIndex="9"/>
                        </GridPane>
                    </VBox>

                    <!-- IMAGE CARD -->
                    <VBox spacing="14" alignment="TOP_CENTER" styleClass="detail-section"
                          prefWidth="240" minWidth="200">
                        <Label text="🖼  Image du produit"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #5856d6;"/>
                        <ImageView fx:id="imgProduit" fitHeight="220" fitWidth="200"
                                   preserveRatio="true" styleClass="image-view"/>
                    </VBox>

                </HBox>

                <!-- BOUTON FERMER -->
                <HBox spacing="12" alignment="CENTER_RIGHT">
                    <Button fx:id="btnFermer" styleClass="close-btn"
                            text="✕  Fermer" onAction="#onFermer"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
