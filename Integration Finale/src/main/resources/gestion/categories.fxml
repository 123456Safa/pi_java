<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.GestionCategorieController"
      stylesheets="@categoriefront.css"
      spacing="0" style="-fx-background-color: #f4f6fb;">

    <!-- ═══ PAGE HEADER ═══ -->
    <VBox styleClass="page-header" spacing="4">
        <HBox alignment="CENTER_LEFT" spacing="20">
            <Label text="Gestion des Catégories" styleClass="main-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="+ Nouvelle Catégorie" styleClass="add-btn"
                    fx:id="btnAjouter" onAction="#onAjouter"/>
        </HBox>
        <HBox spacing="6" alignment="CENTER_LEFT">
            <Label text="Tableau de bord" styleClass="breadcrumb-link"/>
            <Label text="/" styleClass="breadcrumb-sep"/>
            <Label text="Catégories" styleClass="breadcrumb-current"/>
        </HBox>
    </VBox>

    <!-- ═══ CARD LISTE ═══ -->
    <VBox styleClass="list-card" spacing="16" VBox.vgrow="ALWAYS">

        <Label text="Liste des Catégories" styleClass="card-title"/>

        <!-- FILTRES -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="tfRechercheCategorie"
                       promptText="Rechercher par nom ou description..."
                       styleClass="search-field" prefWidth="280"/>
            <ComboBox fx:id="cbTriCategorie"
                      promptText="Trier par"
                      styleClass="filter-combo" prefWidth="160"/>
            <ComboBox fx:id="cbOrdreCategorie"
                      promptText="Ordre"
                      styleClass="filter-combo" prefWidth="140"/>
        </HBox>

        <!-- BOUTONS FILTRE -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button text="🔍  Rechercher"
                    styleClass="filter-btn"
                    fx:id="btnRechercherCategorie"
                    onAction="#onRechercherCategorie"/>
            <Button text="↺  Réinitialiser"
                    styleClass="reset-btn"
                    fx:id="btnResetCategorie"
                    onAction="#onResetRechercheCategorie"/>
        </HBox>

        <!-- TABLEAU -->
        <TableView fx:id="tableCategories" styleClass="product-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNom"         text="NOM"           prefWidth="200"/>
                <TableColumn fx:id="colDescription" text="DESCRIPTION"   prefWidth="320"/>
                <TableColumn fx:id="colCreatedAt"   text="DATE CRÉATION" prefWidth="160"/>
                <TableColumn fx:id="colActions"     text="ACTIONS"       prefWidth="220"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
        
        <!-- PAGINATION -->
        <HBox alignment="CENTER" style="-fx-padding: 10 0 0 0;">
            <Pagination fx:id="pagination" maxPageIndicatorCount="5" />
        </HBox>

    </VBox>

    <!-- ═══ FOOTER ═══ -->
    <HBox styleClass="page-footer" alignment="CENTER">
        <Label text="© 2026 Pharmax" styleClass="footer-label"/>
    </HBox>

</VBox>
