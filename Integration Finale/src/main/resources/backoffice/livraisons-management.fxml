<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.LivraisonController"
      spacing="16" style="-fx-padding: 24; -fx-background-color: #f6f7fb;">

    <Label text="Gestion des Livraisons"
           style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #243248;"/>

    <Label fx:id="countLabel" text="0 livraison(s)"
           style="-fx-font-size: 14; -fx-text-fill: #6b7280;"/>

    <VBox spacing="14" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);">
        <TableView fx:id="livraisonsTable" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="50" minWidth="40" />
                <TableColumn fx:id="lastNameColumn" text="Nom" prefWidth="120" minWidth="100" />
                <TableColumn fx:id="firstNameColumn" text="Prenom" prefWidth="120" minWidth="100" />
                <TableColumn fx:id="emailColumn" text="Email" prefWidth="180" minWidth="150" />
                <TableColumn fx:id="adresseColumn" text="Adresse" prefWidth="250" minWidth="200" />
                <TableColumn fx:id="telColumn" text="Tel" prefWidth="100" minWidth="90" />
                <TableColumn fx:id="createdAtColumn" text="Date" prefWidth="150" minWidth="140" />
            </columns>
        </TableView>
        
        <HBox alignment="CENTER">
            <Pagination fx:id="pagination" maxPageIndicatorCount="5" />
        </HBox>
    </VBox>
</VBox>
