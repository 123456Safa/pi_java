<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="controllers.ModifierStatusController"
            stylesheets="@style3.css"
            style="-fx-background-color: #f4f6fb;">

    <!-- ═══ HEADER ═══ -->
    <top>
        <VBox styleClass="form-header" spacing="4">
            <Label fx:id="lblHeader" styleClass="header-label" text="Modifier le Statut"/>
            <Label text="Mettez à jour l'état de la réclamation" styleClass="header-subtitle"/>
        </VBox>
    </top>

    <!-- ═══ FORMULAIRE ═══ -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox spacing="20" styleClass="form-body" style="-fx-padding: 28;">

                <VBox styleClass="form-card" spacing="18">
                    <Label text="✎  Détails du statut"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #5856d6;"/>

                    <!-- Reclamation Info -->
                    <VBox spacing="8">
                        <Label styleClass="field-label" text="Réclamation" />
                        <Label fx:id="lblReclamation" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-background-color: #f8fafc; -fx-padding: 10; -fx-background-radius: 8;" />
                    </VBox>

                    <Separator/>

                    <!-- NEW STATUS -->
                    <VBox spacing="8">
                        <Label styleClass="field-label" text="Nouveau Statut *" />
                        <ComboBox fx:id="statusBox" promptText="Sélectionner un statut" 
                                  maxWidth="Infinity" styleClass="combo-box" prefHeight="42" />
                    </VBox>

                    <!-- CURRENT STATUS -->
                    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #eff6ff; -fx-padding: 12; -fx-background-radius: 8; -fx-border-color: #dbeafe; -fx-border-width: 1;">
                        <Label style="-fx-font-size: 12; -fx-text-fill: #1e293b; -fx-font-weight: bold;" text="Statut actuel :" />
                        <Label fx:id="lblStatusActuel" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: #1e293b; -fx-padding: 5 12; -fx-background-radius: 4;" />
                    </HBox>
                </VBox>

                <!-- SÉPARATEUR + BOUTONS -->
                <Separator/>
                <HBox spacing="12" alignment="CENTER_RIGHT">
                    <Button onAction="#save" styleClass="button-add" text="✔  Enregistrer" />
                    <Button onAction="#cancel" styleClass="button-cancel" text="✕  Annuler" />
                </HBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
