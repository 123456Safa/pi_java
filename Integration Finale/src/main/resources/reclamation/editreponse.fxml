<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="controllers.EditReponseController"
            stylesheets="@style3.css"
            style="-fx-background-color: #f4f6fb;">

    <!-- ═══ HEADER ═══ -->
    <top>
        <VBox styleClass="form-header" spacing="4">
            <Label fx:id="lblHeader" styleClass="header-label" text="Éditer la Réponse"/>
            <Label text="Modifiez le contenu de votre réponse ci-dessous" styleClass="header-subtitle"/>
        </VBox>
    </top>

    <!-- ═══ FORMULAIRE ═══ -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox spacing="20" styleClass="form-body" style="-fx-padding: 28;">

                <VBox styleClass="form-card" spacing="18">
                    <Label text="💬  Informations de la réponse"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #5856d6;"/>

                    <!-- Reclamation Info -->
                    <VBox spacing="10" style="-fx-background-color: #eff6ff; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #dbeafe; -fx-border-width: 1;">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label style="-fx-font-size: 12; -fx-text-fill: #1e293b; -fx-font-weight: bold;" text="Réclamation :" />
                            <Label fx:id="lblReclamation" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #5856d6;" />
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label style="-fx-font-size: 12; -fx-text-fill: #1e293b; -fx-font-weight: bold;" text="📅 Date :" />
                            <Label fx:id="lblDate" style="-fx-font-size: 12; -fx-text-fill: #64748b;" />
                        </HBox>
                    </VBox>

                    <Separator/>

                    <!-- CONTENU -->
                    <VBox spacing="4">
                        <Label styleClass="field-label" text="Contenu de la réponse *" />
                        <TextArea fx:id="contenu" promptText="Écrivez votre réponse..." 
                                  prefHeight="150" wrapText="true" styleClass="text-area" />
                    </VBox>
                </VBox>

                <!-- SÉPARATEUR + BOUTONS -->
                <Separator/>
                <HBox spacing="12" alignment="CENTER_RIGHT">
                    <Button onAction="#save" styleClass="button-add" text="✔  Enregistrer" />
                    <Button onAction="#cancel" styleClass="button-cancel" text="✕  Annuler" />
                </HBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
