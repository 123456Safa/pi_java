<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.GestionProduitFormController"
            stylesheets="@produitdetail.css"
            style="-fx-background-color: #f4f6fb;">

    <!-- ═══ HEADER ═══ -->
    <top>
        <VBox styleClass="form-header" spacing="4">
            <Label fx:id="lblHeader" styleClass="header-label" text="Ajouter un nouveau produit"/>
            <Label text="Remplissez les informations du produit ci-dessous" styleClass="header-subtitle"/>
        </VBox>
    </top>

    <!-- ═══ FORMULAIRE ═══ -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox spacing="20" styleClass="form-body" style="-fx-padding: 28;">

                <VBox styleClass="form-card" spacing="18">
                    <Label text="📦  Informations du produit"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #5856d6;"/>

                    <!-- NOM -->
                    <VBox spacing="4">
                        <Label styleClass="field-label" text="Nom du produit *"/>
                        <TextField fx:id="tfNom" promptText="Entrez le nom du produit"
                                   styleClass="text-field" prefHeight="42"/>
                        <Label fx:id="lblNomValidation" styleClass="validation-message" text=""/>
                    </VBox>

                    <!-- DESCRIPTION -->
                    <VBox spacing="4">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label styleClass="field-label" text="Description"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="✨  Générer avec IA" onAction="#onGenerateClick" styleClass="btn-ai" focusTraversable="false"/>
                        </HBox>
                        <TextArea fx:id="taDescription" promptText="Entrez la description du produit"
                                  prefHeight="90" wrapText="true" styleClass="text-area"/>
                        <Label fx:id="lblDescriptionValidation" styleClass="validation-message" text=""/>
                    </VBox>

                    <!-- PRIX + QUANTITÉ -->
                    <HBox spacing="20">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label styleClass="field-label" text="Prix (DT) *"/>
                            <TextField fx:id="tfPrix" promptText="0.00"
                                       styleClass="text-field" prefHeight="42"/>
                            <Label fx:id="lblPrixValidation" styleClass="validation-message" text=""/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label styleClass="field-label" text="Quantité en stock *"/>
                            <TextField fx:id="tfQuantite" promptText="0"
                                       styleClass="text-field" prefHeight="42"/>
                            <Label fx:id="lblQuantiteValidation" styleClass="validation-message" text=""/>
                        </VBox>
                    </HBox>

                    <!-- STATUT + CATÉGORIE -->
                    <HBox spacing="20">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label styleClass="field-label" text="Statut *"/>
                            <ComboBox fx:id="cbStatut" prefHeight="42"
                                      promptText="Choisir un statut"
                                      styleClass="combo-box" maxWidth="1.7976931348623157E308"/>
                            <Label fx:id="lblStatutValidation" styleClass="validation-message" text=""/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label styleClass="field-label" text="Catégorie *"/>
                            <ComboBox fx:id="cbCategorie" prefHeight="42"
                                      promptText="Choisir une catégorie"
                                      styleClass="combo-box" maxWidth="1.7976931348623157E308"/>
                            <Label fx:id="lblCategorieValidation" styleClass="validation-message" text=""/>
                        </VBox>
                    </HBox>

                    <!-- DATE EXPIRATION -->
                    <VBox spacing="4">
                        <Label styleClass="field-label" text="Date d'expiration"/>
                        <DatePicker fx:id="dpDateExpiration" prefHeight="42"
                                    styleClass="date-picker" maxWidth="1.7976931348623157E308"/>
                        <Label fx:id="lblDateExpirationValidation" styleClass="validation-message" text=""/>
                    </VBox>

                    <!-- IMAGE -->
                    <VBox spacing="6">
                        <Label styleClass="field-label" text="Image du produit"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <TextField fx:id="tfImage" promptText="Chemin ou URL de l'image"
                                       styleClass="text-field" prefHeight="42" HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnBrowseImage" text="📁  Parcourir"
                                    onAction="#onBrowseImage" styleClass="btn-browse"/>
                        </HBox>
                        <Label fx:id="lblImageValidation" styleClass="validation-message" text=""/>
                        <ImageView fx:id="imgPreview" fitHeight="110" fitWidth="110"
                                   preserveRatio="true" styleClass="image-view"/>
                    </VBox>

                </VBox>

                <!-- SÉPARATEUR + BOUTONS -->
                <Separator/>
                <HBox spacing="12" alignment="CENTER_RIGHT">
                    <Button fx:id="btnAjouter" styleClass="button-add"
                            text="✔  Enregistrer" onAction="#onAjouter"/>
                    <Button fx:id="btnAnnuler" styleClass="button-cancel"
                            text="✕  Annuler" onAction="#onAnnuler"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
