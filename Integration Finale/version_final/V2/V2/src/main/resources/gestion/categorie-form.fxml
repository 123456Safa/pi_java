<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.GestionCategorieFormController"
            stylesheets="@produitdetail.css"
            style="-fx-background-color: #f4f6fb;">

    <!-- ═══ HEADER ═══ -->
    <top>
        <VBox styleClass="form-header" spacing="4">
            <Label fx:id="lblHeader" styleClass="header-label" text="Ajouter une catégorie"/>
            <Label text="Remplissez les informations de la catégorie ci-dessous" styleClass="header-subtitle"/>
        </VBox>
    </top>

    <!-- ═══ FORMULAIRE ═══ -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox spacing="20" styleClass="form-body" style="-fx-padding: 28;">

                <VBox styleClass="form-card" spacing="18">
                    <Label text="🗂  Informations de la catégorie"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #5856d6;"/>

                    <!-- NOM -->
                    <VBox spacing="4">
                        <Label styleClass="field-label" text="Nom de la catégorie *"/>
                        <TextField fx:id="tfNom" promptText="Entrez le nom de la catégorie"
                                   styleClass="text-field" prefHeight="42"/>
                        <Label fx:id="lblNomValidation" styleClass="validation-message" text=""/>
                    </VBox>

                    <!-- DESCRIPTION -->
                    <VBox spacing="4">
                        <Label styleClass="field-label" text="Description"/>
                        <TextArea fx:id="taDescription" promptText="Entrez la description de la catégorie"
                                  prefHeight="100" wrapText="true" styleClass="text-area"/>
                        <Label fx:id="lblDescriptionValidation" styleClass="validation-message" text=""/>
                    </VBox>

                </VBox>

                <!-- SÉPARATEUR + BOUTONS -->
                <Separator/>
                <HBox spacing="12" alignment="CENTER_RIGHT">
                    <Button fx:id="btnAjouter" styleClass="button-add"
                            text="✔  Enregistrer" onAction="#onAjouter"/>
                    <Button fx:id="btnAnnuler" styleClass="button-cancel"
                            text="✕  Annuler" onAction="#onAnnuler"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
