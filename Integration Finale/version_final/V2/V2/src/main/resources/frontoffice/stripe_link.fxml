<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<VBox xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.frontoffice.StripeLinkController"
      alignment="TOP_CENTER" spacing="22"
      prefWidth="520"
      style="-fx-background-color: white; -fx-padding: 28 34 30 34;">

    <VBox alignment="CENTER" spacing="6">
        <Label text="Commande Pharmax" style="-fx-text-fill: #5f6368; -fx-font-size: 18; -fx-font-weight: bold;"/>
        <Label fx:id="amountLabel" text="0,00 DT" style="-fx-text-fill: #1f2937; -fx-font-size: 34; -fx-font-weight: bold;"/>
    </VBox>

    <HBox spacing="10" alignment="CENTER" maxWidth="Infinity">
        <Button text="Payer avec link"
                style="-fx-background-color: #00d66f; -fx-text-fill: #061b12; -fx-font-size: 18; -fx-font-weight: bold; -fx-background-radius: 7; -fx-padding: 14 22; -fx-cursor: hand;"/>
        <Button text="amazon pay"
                style="-fx-background-color: #ffd814; -fx-text-fill: #111827; -fx-font-size: 18; -fx-font-weight: bold; -fx-background-radius: 7; -fx-padding: 14 28; -fx-cursor: hand;"/>
    </HBox>

    <HBox alignment="CENTER" spacing="12" maxWidth="Infinity">
        <Region prefHeight="1" HBox.hgrow="ALWAYS" style="-fx-background-color: #e5e7eb;"/>
        <Label text="OU" style="-fx-text-fill: #64748b; -fx-font-size: 14;"/>
        <Region prefHeight="1" HBox.hgrow="ALWAYS" style="-fx-background-color: #e5e7eb;"/>
    </HBox>

    <VBox spacing="8" maxWidth="Infinity">
        <Label text="E-mail" style="-fx-text-fill: #334155; -fx-font-size: 13; -fx-font-weight: bold;"/>
        <TextField fx:id="emailField" promptText="email@exemple.com"
                   style="-fx-background-color: white; -fx-border-color: #d8dee4; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12; -fx-font-size: 15;"/>
    </VBox>

    <VBox spacing="12" maxWidth="Infinity">
        <Label text="Moyen de paiement" style="-fx-text-fill: #111827; -fx-font-size: 20; -fx-font-weight: bold;"/>

        <VBox maxWidth="Infinity" style="-fx-border-color: #d8dee4; -fx-border-radius: 8; -fx-background-radius: 8; -fx-background-color: white;">
            <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 15; -fx-border-color: transparent transparent #e5e7eb transparent;">
                <Circle radius="9" fill="white" stroke="#9ca3af"/>
                <Label text="Carte" style="-fx-text-fill: #333333; -fx-font-size: 15;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="VISA" style="-fx-text-fill: #1d4ed8; -fx-font-size: 11; -fx-font-weight: bold;"/>
                <Label text="MC" style="-fx-text-fill: #b91c1c; -fx-font-size: 11; -fx-font-weight: bold;"/>
                <Label text="AMEX" style="-fx-text-fill: #2563eb; -fx-font-size: 11; -fx-font-weight: bold;"/>
            </HBox>

            <VBox spacing="10" style="-fx-padding: 14 15 16 15;">
                <HBox fx:id="savedCardBox" alignment="CENTER_LEFT" spacing="10" visible="false" managed="false"
                      style="-fx-background-color: #eef8f2; -fx-background-radius: 8; -fx-padding: 10;">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="Carte enregistree" style="-fx-text-fill: #166534; -fx-font-size: 12; -fx-font-weight: bold;"/>
                        <Label fx:id="savedCardLabel" text="**** **** **** 4242" style="-fx-text-fill: #1f2937; -fx-font-size: 14; -fx-font-weight: bold;"/>
                    </VBox>
                    <Button text="Autre carte" onAction="#handleUseAnotherCard"
                            style="-fx-background-color: white; -fx-border-color: #16a34a; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #166534; -fx-font-size: 12; -fx-font-weight: bold;"/>
                </HBox>
                <TextField fx:id="cardNumberField" promptText="Numero de carte"
                           style="-fx-background-color: white; -fx-border-color: #d8dee4; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 11; -fx-font-size: 14;"/>
                <HBox spacing="10">
                    <TextField fx:id="expField" promptText="MM / AA"
                               style="-fx-background-color: white; -fx-border-color: #d8dee4; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 11; -fx-font-size: 14;" HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="cvcField" promptText="CVC"
                               style="-fx-background-color: white; -fx-border-color: #d8dee4; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 11; -fx-font-size: 14;" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>
        </VBox>
    </VBox>

    <HBox alignment="TOP_LEFT" spacing="10" maxWidth="Infinity" style="-fx-padding: 4 0 0 0;">
        <CheckBox fx:id="saveInfoCheckBox"/>
        <VBox spacing="4">
            <Label text="Enregistrer mes informations pour regler plus rapidement"
                   wrapText="true"
                   style="-fx-text-fill: #1f2937; -fx-font-size: 14; -fx-font-weight: bold;"/>
            <Label text="Paiement de test dans l'application."
                   wrapText="true"
                   style="-fx-text-fill: #64748b; -fx-font-size: 12;"/>
        </VBox>
    </HBox>

    <Label fx:id="errorLabel" text="" wrapText="true" style="-fx-text-fill: #df1b41; -fx-font-size: 13;"/>

    <Button fx:id="payerBtn" text="Payer" onAction="#handlePayer" maxWidth="Infinity"
            style="-fx-background-color: #635bff; -fx-text-fill: white; -fx-font-size: 17; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 14 0; -fx-cursor: hand;"/>

    <Label text="Annuler" onMouseClicked="#handleAnnuler"
           style="-fx-text-fill: #635bff; -fx-font-size: 14; -fx-cursor: hand;"/>
</VBox>
