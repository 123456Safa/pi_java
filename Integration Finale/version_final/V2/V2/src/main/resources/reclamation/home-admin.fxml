<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="controllers.HomeAdminController" 
            stylesheets="@pagination.css,@style3.css"
            style="-fx-background-color: #f4f6fb;">

  
  

    <!-- ═══ APPBAR & HEADER ═══ -->
    <top>
        <VBox spacing="0">
            
            <VBox styleClass="page-header" spacing="4">
                <Label text="Tableau de Bord Admin" styleClass="main-title"/>
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <Label text="Tableau de bord" styleClass="breadcrumb-link"/>
                    <Label text="/" styleClass="breadcrumb-sep"/>
                    <Label text="Réclamations" styleClass="breadcrumb-current"/>
                </HBox>
            </VBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox spacing="24" styleClass="form-body" style="-fx-padding: 28;">
                
                <!-- Statistics Cards Grid -->
                <HBox spacing="16" alignment="CENTER_LEFT">
                    <!-- Total Reclamations -->
                    <VBox spacing="10" alignment="CENTER" styleClass="form-card" style="-fx-pref-width: 200; -fx-padding: 20;">
                        <Label text="📄" style="-fx-font-size: 30;" />
                        <Label text="Réclamations" style="-fx-font-size: 11; -fx-text-fill: #64748b; -fx-font-weight: bold;" />
                        <Label fx:id="totalReclamationsLabel" text="0" style="-fx-font-size: 32; -fx-font-weight: 900; -fx-text-fill: #0f172a;" />
                    </VBox>

                    <!-- En Attente -->
                    <VBox spacing="10" alignment="CENTER" styleClass="form-card" style="-fx-pref-width: 200; -fx-padding: 20; -fx-border-color: #fbbf24;">
                        <Label text="🕒" style="-fx-font-size: 30;" />
                        <Label text="En Attente" style="-fx-font-size: 11; -fx-text-fill: #92400e; -fx-font-weight: bold;" />
                        <Label fx:id="enAttenteLabel" text="0" style="-fx-font-size: 32; -fx-font-weight: 900; -fx-text-fill: #d97706;" />
                    </VBox>

                    <!-- En Cours -->
                    <VBox spacing="10" alignment="CENTER" styleClass="form-card" style="-fx-pref-width: 200; -fx-padding: 20; -fx-border-color: #22d3ee;">
                        <Label text="🔄" style="-fx-font-size: 30;" />
                        <Label text="En Cours" style="-fx-font-size: 11; -fx-text-fill: #164e63; -fx-font-weight: bold;" />
                        <Label fx:id="enCoursLabel" text="0" style="-fx-font-size: 32; -fx-font-weight: 900; -fx-text-fill: #0891b2;" />
                    </VBox>

                    <!-- Résolue -->
                    <VBox spacing="10" alignment="CENTER" styleClass="form-card" style="-fx-pref-width: 200; -fx-padding: 20; -fx-border-color: #86efac;">
                        <Label text="✅" style="-fx-font-size: 30;" />
                        <Label text="Résolu" style="-fx-font-size: 11; -fx-text-fill: #15803d; -fx-font-weight: bold;" />
                        <Label fx:id="resolueLabel" text="0" style="-fx-font-size: 32; -fx-font-weight: 900; -fx-text-fill: #16a34a;" />
                    </VBox>

                    <!-- Sans Réponse -->
                    <VBox spacing="10" alignment="CENTER" styleClass="form-card" style="-fx-pref-width: 200; -fx-padding: 20; -fx-border-color: #fca5a5;">
                        <Label text="⏰" style="-fx-font-size: 30;" />
                        <Label text="Sans Réponse" style="-fx-font-size: 11; -fx-text-fill: #7c2d12; -fx-font-weight: bold;" />
                        <Label fx:id="sansReponse2JoursLabel" text="0" style="-fx-font-size: 32; -fx-font-weight: 900; -fx-text-fill: #dc2626;" />
                    </VBox>
                </HBox>

                <!-- Table Card -->
                <VBox styleClass="form-card" spacing="0" style="-fx-padding: 0;">
                    <!-- Search & Filters -->
                    <VBox spacing="16" style="-fx-padding: 20;">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <TextField fx:id="searchField" promptText="Rechercher..." HBox.hgrow="ALWAYS" styleClass="text-field" prefHeight="40"/>
                            <Button onAction="#resetFilters" styleClass="button-cancel" text="↺ Reset" />
                        </HBox>
                        
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <VBox spacing="4">
                                <Label text="STATUT" style="-fx-font-size: 10; -fx-font-weight: bold;" />
                                <ComboBox fx:id="statusFilter" prefWidth="130" styleClass="combo-box" />
                            </VBox>
                            <VBox spacing="4">
                                <Label text="DATE" style="-fx-font-size: 10; -fx-font-weight: bold;" />
                                <DatePicker fx:id="dateFilter" prefWidth="140" styleClass="date-picker" />
                            </VBox>
                            <VBox spacing="4">
                                <Label text="TRIER PAR" style="-fx-font-size: 10; -fx-font-weight: bold;" />
                                <ComboBox fx:id="sortByField" prefWidth="140" styleClass="combo-box" />
                            </VBox>
                            <VBox spacing="4">
                                <Label text="ORDRE" style="-fx-font-size: 10; -fx-font-weight: bold;" />
                                <ComboBox fx:id="sortOrder" prefWidth="110" styleClass="combo-box" />
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Table -->
                    <TableView fx:id="table" minHeight="400" styleClass="table-view">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colTitre" text="RÉCLAMATION" />
                            <TableColumn fx:id="colUser" text="UTILISATEUR" />
                            <TableColumn fx:id="colStatut" text="STATUT" />
                            <TableColumn fx:id="colDate" text="DATE" />
                            <TableColumn fx:id="colReponses" text="RÉPONSES" />
                            <TableColumn fx:id="colMessage" text="DERNIER MESSAGE" />
                            <TableColumn fx:id="colAction" text="ACTIONS" />
                        </columns>
                    </TableView>

                    <!-- Pagination -->
                    <HBox alignment="CENTER" style="-fx-padding: 15;">
                        <Pagination fx:id="pagination" maxPageIndicatorCount="5" style="-fx-page-information-visible: false;" />
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>