<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.CategorieFormController">
   <style>
      .form-section {
         -fx-padding: 20;
      }
      .form-label {
         -fx-font-size: 12;
         -fx-text-fill: #333333;
         -fx-font-weight: bold;
      }
      .form-field {
         -fx-padding: 10;
         -fx-font-size: 12;
         -fx-border-color: #d0d0d0;
         -fx-border-width: 1;
      }
      .btn-ajouter {
         -fx-padding: 10 30;
         -fx-font-size: 13;
         -fx-background-color: #5856d6;
         -fx-text-fill: white;
         -fx-font-weight: bold;
         -fx-cursor: hand;
      }
      .btn-annuler {
         -fx-padding: 10 30;
         -fx-font-size: 13;
         -fx-background-color: #999999;
         -fx-text-fill: white;
         -fx-font-weight: bold;
         -fx-cursor: hand;
      }
   </style>

   <top>
      <VBox style="-fx-background-color: #f5f5f5; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0; -fx-padding: 20;">
         <Label fx:id="lblHeader" text="Ajouter une catégorie" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #333333;" />
      </VBox>
   </top>

   <center>
      <VBox styleClass="form-section" spacing="20">
         <!-- Nom -->
         <VBox spacing="5">
            <Label text="Nom de la catégorie *" styleClass="form-label" />
            <TextField fx:id="tfNom" promptText="Entrez le nom de la catégorie" styleClass="form-field" />
         </VBox>

         <!-- Description -->
         <VBox spacing="5" VBox.vgrow="ALWAYS">
            <Label text="Description" styleClass="form-label" />
            <TextArea fx:id="taDescription" promptText="Entrez la description..." styleClass="form-field" wrapText="true" VBox.vgrow="ALWAYS" />
         </VBox>

         <!-- Boutons -->
         <HBox spacing="10" alignment="CENTER">
            <Button fx:id="btnAjouter" styleClass="btn-ajouter" mnemonicParsing="false" onAction="#onAjouter" text="Ajouter" />
            <Button fx:id="btnAnnuler" styleClass="btn-annuler" mnemonicParsing="false" onAction="#onAnnuler" text="Annuler" />
         </HBox>
      </VBox>
   </center>
</BorderPane>

