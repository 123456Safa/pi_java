<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" style="-fx-padding: 30; -fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.EditReclamationController">

    <!-- Header -->
    <Label style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #333333;" text=" Éditer la Réclamation" />

    <!-- Main Card -->
    <VBox spacing="20" style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-radius: 8; -fx-padding: 30;">

        <!-- Titre Section -->
        <VBox spacing="8">
            <Label style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #333333;" text="TITRE *" />
            <TextField fx:id="titre" promptText="Résumé de votre réclamation" style="-fx-font-size: 12; -fx-padding: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 4;" />
            <HBox spacing="10" style="-fx-alignment: center-left;">
                <Label style="-fx-font-size: 11; -fx-text-fill: #999999;" text="Entre 5 et 255 caractères" />
                <Label fx:id="titreCharCount" style="-fx-font-size: 11; -fx-text-fill: #999999;" text="0/255" />
            </HBox>
        </VBox>

        <!-- 🔴 error titre -->
        <Label fx:id="titreError" style="-fx-text-fill: #FF4444; -fx-font-size: 11;" />

        <!-- Description Section -->
        <VBox spacing="8">
            <Label style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #333333;" text="DESCRIPTION *" />
            <TextArea fx:id="description" promptText="Décrivez votre problème en détail..." style="-fx-font-size: 12; -fx-padding: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 4; -fx-control-inner-background: white;" wrapText="true" />
            <HBox spacing="10" style="-fx-alignment: center-left;">
                <Label style="-fx-font-size: 11; -fx-text-fill: #999999;" text="Entre 20 et 2000 caractères" />
                <Label fx:id="descCharCount" style="-fx-font-size: 11; -fx-text-fill: #999999;" text="0/2000" />
            </HBox>
        </VBox>

        <!-- 🔴 error description -->
        <Label fx:id="descError" style="-fx-text-fill: #FF4444; -fx-font-size: 11;" />

        <!-- Current Status Info -->
        <HBox spacing="15" style="-fx-background-color: #e0f4ff; -fx-border-color: #87ceeb; -fx-border-radius: 4; -fx-padding: 15; -fx-alignment: center-left;">
            <Label style="-fx-font-size: 12; -fx-text-fill: #333333;" text=" Statut actuel :" />
            <Label fx:id="lblStatusActuel" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: #FFA500; -fx-padding: 5 10; -fx-border-radius: 3;" />
        </HBox>

        <!-- Buttons -->
        <HBox spacing="15" style="-fx-alignment: center-left; -fx-padding: 20 0 0 0;">
            <Button onAction="#save" style="-fx-font-size: 13; -fx-padding: 10 25; -fx-text-fill: #0066cc; -fx-background-color: transparent; -fx-border-color: #0066cc; -fx-border-radius: 4; -fx-cursor: hand;" text="📅 Enregistrer les Modifications" />
            <Button onAction="#cancel" style="-fx-font-size: 13; -fx-padding: 10 25; -fx-text-fill: #666666; -fx-background-color: transparent; -fx-border-color: #cccccc; -fx-border-radius: 4; -fx-cursor: hand;" text="✖️ Annuler" />
        </HBox>

    </VBox>

</VBox>
