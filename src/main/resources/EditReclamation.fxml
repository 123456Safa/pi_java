<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.EditReclamationController"
      spacing="10"
      style="-fx-padding:15;">

    <TextField fx:id="titre" promptText="Titre"/>
    <TextField fx:id="description" promptText="Description"/>

    <Button text="Enregistrer" onAction="#save"/>
    <Button text="Annuler" onAction="#cancel"/>

</VBox>