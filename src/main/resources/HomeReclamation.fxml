<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Pagination?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.HomeReclamationController"
      spacing="20"
      style="-fx-padding: 30; -fx-background-color: #f5f5f5;">

    <!-- Header -->
    <VBox spacing="5" style="-fx-padding: 0;">
        <Label text="Réclamations" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #333333;"/>
        <Label text="Consultez vos réclamations et vos demandes de support" style="-fx-font-size: 13; -fx-text-fill: #999999;"/>
    </VBox>

    <!-- Search Bar -->
    <TextField fx:id="searchField" promptText="Rechercher par titre ou description..."
               style="-fx-font-size: 12; -fx-padding: 10; -fx-control-inner-background: white; -fx-border-radius: 5; -fx-border-color: #e0e0e0;"
               onKeyReleased="#handleSearch"/>

    <!-- Add Button -->
    <Button text="+ Nouvelle Réclamation" onAction="#openAdd"
            style="-fx-font-size: 13; -fx-padding: 8 15; -fx-text-fill: #0066cc; -fx-background-color: transparent; -fx-border-color: transparent; -fx-cursor: hand;"/>

    <Pagination fx:id="pagination" VBox.vgrow="ALWAYS" />

</VBox>