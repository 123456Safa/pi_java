<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="310.0" prefWidth="436.0" spacing="10"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.FormReclamationController">

    <!-- Titre -->
    <TextField fx:id="titre" promptText="Titre">
        <VBox.margin>
            <Insets top="50.0"/>
        </VBox.margin>
    </TextField>

    <!-- 🔴 error titre -->
    <Label fx:id="titreError" style="-fx-text-fill:red;" />

    <!-- Description -->
    <TextArea fx:id="description" promptText="Description">
        <VBox.margin>
            <Insets top="20.0"/>
        </VBox.margin>
    </TextArea>

    <!-- 🔴 error description -->
    <Label fx:id="descError" style="-fx-text-fill:red;" />

    <!-- Buttons -->
    <HBox spacing="10">
        <Button text="Enregistrer" onAction="#save"/>
        <Button text="Annuler" onAction="#cancel"/>
    </HBox>

</VBox>