<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="310.0" prefWidth="436.0" spacing="10" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.FormReclamationController">

    <TextField fx:id="titre" alignment="TOP_LEFT" prefHeight="26.0" prefWidth="401.0" promptText="Titre">
      <opaqueInsets>
         <Insets />
      </opaqueInsets>
      <VBox.margin>
         <Insets top="50.0" />
      </VBox.margin></TextField>
    <TextField fx:id="description" prefHeight="36.0" prefWidth="436.0" promptText="Description">
      <VBox.margin>
         <Insets top="20.0" />
      </VBox.margin>
   </TextField>

    <HBox prefHeight="20.0" prefWidth="253.0" spacing="10">
      <children>
           <Button onAction="#save" text="Enregistrer" />
           <Button onAction="#cancel" text="Annuler" />
      </children>
      <VBox.margin>
         <Insets left="150.0" right="20.0" top="40.0" />
      </VBox.margin>
    </HBox>

</VBox>
