<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="650.0" prefWidth="900.0" spacing="0" style="-fx-background-color: #f8f9fa;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.FormReclamationController">

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
        <VBox spacing="24" style="-fx-padding: 40 45 40 45;">

            <!-- Header -->
            <VBox spacing="8">
                <Label text="➕ Nouvelle Réclamation" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                <Label text="Signalez un problème et nous vous aiderons" style="-fx-font-size: 14; -fx-text-fill: #64748b;"/>
            </VBox>

            <!-- Main Card -->
            <VBox spacing="24" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 14; -fx-border-width: 1; -fx-padding: 32; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.08), 12, 0, 0, 4);">

                <!-- Titre Section -->
                <VBox spacing="10">
                    <Label text="TITRE *" style="-fx-font-size: 13; -fx-font-weight: 600; -fx-text-fill: #1e293b;"/>
                    <TextField fx:id="titre" promptText="Résumé de votre réclamation"
                               style="-fx-font-size: 13; -fx-padding: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-control-inner-background: #f8fafc; -fx-border-width: 1;"/>
                    <HBox spacing="12" style="-fx-alignment: center-left;">
                        <Label text="Entre 5 et 255 caractères" style="-fx-font-size: 12; -fx-text-fill: #94a3b8;"/>
                        <Label fx:id="titreCharCount" text="0/255" style="-fx-font-size: 12; -fx-text-fill: #6366f1; -fx-font-weight: 600;"/>
                    </HBox>
                </VBox>

                <!-- 🔴 error titre -->
                <Label fx:id="titreError" style="-fx-text-fill: #ef4444; -fx-font-size: 12; -fx-font-weight: 600;"/>

                <!-- Description Section -->
                <VBox spacing="10">
                    <Label text="DESCRIPTION *" style="-fx-font-size: 13; -fx-font-weight: 600; -fx-text-fill: #1e293b;"/>
                    <TextArea fx:id="description" promptText="Décrivez votre problème en détail..."
                              wrapText="true"
                              prefHeight="140"
                              style="-fx-font-size: 13; -fx-padding: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-control-inner-background: #f8fafc; -fx-border-width: 1; -fx-font-family: 'Segoe UI', 'Ubuntu';"/>
                    <HBox spacing="12" style="-fx-alignment: center-left;">
                        <Label text="Entre 20 et 2000 caractères" style="-fx-font-size: 12; -fx-text-fill: #94a3b8;"/>
                        <Label fx:id="descCharCount" text="0/2000" style="-fx-font-size: 12; -fx-text-fill: #6366f1; -fx-font-weight: 600;"/>
                    </HBox>
                </VBox>

                <!-- 🔴 error description -->
                <Label fx:id="descError" style="-fx-text-fill: #ef4444; -fx-font-size: 12; -fx-font-weight: 600;"/>

                <!-- Buttons -->
                <HBox spacing="12" style="-fx-alignment: center-left; -fx-padding: 16 0 0 0;">
                    <Button text="▶ Soumettre la Réclamation" onAction="#save"
                            style="-fx-font-size: 13; -fx-padding: 12 28; -fx-text-fill: white; -fx-background-color: #6366f1; -fx-border-color: transparent; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: 600;"/>
                    <Button text="← Annuler" onAction="#cancel"
                            style="-fx-font-size: 13; -fx-padding: 12 28; -fx-text-fill: #475569; -fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: 600;"/>
                </HBox>

            </VBox>

        </VBox>
    </ScrollPane>

</VBox>