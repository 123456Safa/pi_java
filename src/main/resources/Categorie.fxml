<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.CategorieController" stylesheets="@categoriefront.css">

   <left>
      <VBox spacing="20" styleClass="sidebar">
         <VBox alignment="CENTER" spacing="10" styleClass="sidebar-logo">
            <ImageView fitWidth="90" fitHeight="90" pickOnBounds="true" preserveRatio="true" fx:id="logoImage" />
            <Label text="pharmaX" styleClass="sidebar-title" />
         </VBox>
         <VBox spacing="10" styleClass="sidebar-links">
            <Button text="Tableau de bord" styleClass="sidebar-btn" />
            <Button text="Produits" styleClass="sidebar-btn" />
            <Button text="Catégories" styleClass="sidebar-btn sidebar-btn-active" />
         </VBox>
      </VBox>
   </left>

   <!-- Main Content -->
   <center>
      <VBox spacing="20" style="-fx-padding: 30;">

         <!-- Header -->
         <HBox alignment="CENTER_LEFT" spacing="20">
            <Label text="Gestion des Catégories" styleClass="main-title" />
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Nouveau Catégorie" styleClass="add-btn"
                    fx:id="btnAjouter" onAction="#onAjouter"/>
         </HBox>

         <!-- Filtres -->
         <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="tfRechercheCategorie"
                       promptText="Rechercher par nom ou description..."
                       styleClass="search-field"/>

            <ComboBox fx:id="cbTriCategorie"
                      promptText="Trier par"
                      styleClass="filter-combo"/>

            <ComboBox fx:id="cbOrdreCategorie"
                      promptText="Ordre"
                      styleClass="filter-combo"/>

            <Button text="Rechercher"
                    styleClass="filter-btn"
                    fx:id="btnRechercherCategorie"
                    onAction="#onRechercherCategorie"/>

            <Button text="Réinitialiser"
                    styleClass="reset-btn"
                    fx:id="btnResetCategorie"
                    onAction="#onResetRechercheCategorie"/>
         </HBox>

         <!-- Table -->
         <TableView fx:id="tableCategories" styleClass="product-table">
            <columns>
               <TableColumn fx:id="colNom" text="NOM"/>
               <TableColumn fx:id="colDescription" text="DESCRIPTION"/>
               <TableColumn fx:id="colCreatedAt" text="DATE CRÉATION"/>
               <TableColumn fx:id="colActions" text="ACTIONS"/>
            </columns>

            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
            </columnResizePolicy>
         </TableView>

      </VBox>
   </center>

</BorderPane>