<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.CategorieController" stylesheets="@categoriefront.css" spacing="20" style="-fx-padding: 30;">

   <!-- Header -->
   <HBox alignment="CENTER_LEFT" spacing="20">
      <Label text="Gestion des Catégories" styleClass="main-title" />
      <Region HBox.hgrow="ALWAYS" />
      <Button text="Nouveau Catégorie" styleClass="add-btn"
              fx:id="btnAjouter" onAction="#onAjouter"/>
   </HBox>

   <!-- Filtres -->
   <HBox spacing="10" alignment="CENTER_LEFT">
      <TextField fx:id="tfRechercheCategorie"
                 promptText="Rechercher par nom ou description..."
                 styleClass="search-field"/>

      <ComboBox fx:id="cbTriCategorie"
                promptText="Trier par"
                styleClass="filter-combo"/>

      <ComboBox fx:id="cbOrdreCategorie"
                promptText="Ordre"
                styleClass="filter-combo"/>

      <Button text="Rechercher"
              styleClass="filter-btn"
              fx:id="btnRechercherCategorie"
              onAction="#onRechercherCategorie"/>

      <Button text="Réinitialiser"
              styleClass="reset-btn"
              fx:id="btnResetCategorie"
              onAction="#onResetRechercheCategorie"/>
   </HBox>

   <!-- Table -->
   <TableView fx:id="tableCategories" styleClass="product-table" VBox.vgrow="ALWAYS">
      <columns>
         <TableColumn fx:id="colNom" text="NOM"/>
         <TableColumn fx:id="colDescription" text="DESCRIPTION"/>
         <TableColumn fx:id="colCreatedAt" text="DATE CRÉATION"/>
         <TableColumn fx:id="colActions" text="ACTIONS"/>
      </columns>

      <columnResizePolicy>
         <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
      </columnResizePolicy>
   </TableView>

</VBox>
