<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ProduitController">
   <style>
      .header-section {
         -fx-background-color: #f5f5f5;
         -fx-border-color: #e0e0e0;
         -fx-border-width: 0 0 1 0;
         -fx-padding: 20;
      }
      .search-btn {
         -fx-font-size: 12;
         -fx-padding: 8 20;
         -fx-background-color: #5856d6;
         -fx-text-fill: white;
         -fx-font-weight: bold;
         -fx-cursor: hand;
      }
      .reset-btn {
         -fx-font-size: 12;
         -fx-padding: 8 20;
         -fx-background-color: #999999;
         -fx-text-fill: white;
         -fx-font-weight: bold;
         -fx-cursor: hand;
      }
      .add-btn {
         -fx-font-size: 12;
         -fx-padding: 8 20;
         -fx-background-color: #5856d6;
         -fx-text-fill: white;
         -fx-font-weight: bold;
         -fx-cursor: hand;
      }
      .title {
         -fx-font-size: 18;
         -fx-font-weight: bold;
         -fx-text-fill: #333333;
      }
   </style>

   <top>
      <VBox styleClass="header-section" spacing="15">
         <Label text="Filtres et Recherche" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #333333;" />

         <GridPane hgap="15" vgap="10">
            <columnConstraints>
               <ColumnConstraints prefWidth="300" />
               <ColumnConstraints prefWidth="250" />
               <ColumnConstraints prefWidth="250" />
               <ColumnConstraints prefWidth="200" />
            </columnConstraints>
            <rowConstraints>
               <RowConstraints prefHeight="40" />
            </rowConstraints>

            <VBox GridPane.columnIndex="0" spacing="5">
               <Label text="Rechercher" style="-fx-font-size: 11; -fx-text-fill: #666666;" />
               <TextField fx:id="tfRechercheProduit" promptText="Nom ou description..." prefHeight="32" />
            </VBox>

            <VBox GridPane.columnIndex="1" spacing="5">
               <Label text="Catégorie" style="-fx-font-size: 11; -fx-text-fill: #666666;" />
               <ComboBox fx:id="cbCategorieProduit" prefHeight="32" promptText="Toutes les catégories" />
            </VBox>

            <VBox GridPane.columnIndex="2" spacing="5">
               <Label text="Trier par" style="-fx-font-size: 11; -fx-text-fill: #666666;" />
               <ComboBox fx:id="cbTriProduit" prefHeight="32" promptText="Date d'ajout" />
            </VBox>

            <VBox GridPane.columnIndex="3" spacing="5">
               <Label text="Ordre" style="-fx-font-size: 11; -fx-text-fill: #666666;" />
               <ComboBox fx:id="cbOrdreProduit" prefHeight="32" promptText="↓ Décroissant" />
            </VBox>
         </GridPane>

         <HBox spacing="10">
            <Button fx:id="btnRechercherProduit" styleClass="search-btn" text="🔍 Rechercher" onAction="#onRechercherProduit" />
            <Button fx:id="btnResetProduit" styleClass="reset-btn" text="↻ Réinitialiser" onAction="#onResetRechercheProduit" />
         </HBox>
      </VBox>
   </top>

   <center>
      <VBox style="-fx-padding: 20;" spacing="15">
         <HBox spacing="10" alignment="CENTER_LEFT">
            <Label styleClass="title" text="Liste des Produits" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnAjouter" styleClass="add-btn" mnemonicParsing="false" onAction="#onAjouter" text="+ Ajouter un produit" />
         </HBox>

          <TableView fx:id="tableProduits" prefHeight="400.0" VBox.vgrow="ALWAYS" style="-fx-font-size: 12;">
             <columns>
                <TableColumn fx:id="colNom" prefWidth="150" text="NOM" />
                <TableColumn fx:id="colDescription" prefWidth="150" text="DESCRIPTION" />
                <TableColumn fx:id="colPrix" prefWidth="80" text="PRIX" />
                <TableColumn fx:id="colQuantite" prefWidth="100" text="QUANTITÉ" />
                <TableColumn fx:id="colStatut" prefWidth="100" text="STATUT" />
                <TableColumn fx:id="colDateExpiration" prefWidth="130" text="DATE EXPIRATION" />
                <TableColumn fx:id="colCategorieId" prefWidth="100" text="CATÉGORIE" />
                <TableColumn fx:id="colImage" prefWidth="80" text="IMAGE" />
                <TableColumn fx:id="colActions" prefWidth="180" text="ACTIONS" />
             </columns>
             <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS" />
             </columnResizePolicy>
          </TableView>
      </VBox>
   </center>
</BorderPane>
