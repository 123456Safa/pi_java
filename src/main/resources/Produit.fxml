<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml" fx:controller="controllers.ProduitController" stylesheets="@produitfront.css">
    <!-- Sidebar -->
    <left>
        <VBox spacing="20" styleClass="sidebar">
            <VBox alignment="CENTER" spacing="10" styleClass="sidebar-logo">
                <ImageView fitWidth="90" fitHeight="90" pickOnBounds="true" preserveRatio="true" fx:id="logoImage" />
                <Label text="pharmaX" styleClass="sidebar-title" />
            </VBox>
            <VBox spacing="10" styleClass="sidebar-links">
                <Button text="Tableau de bord" styleClass="sidebar-btn" />
                <Button text="Produits" styleClass="sidebar-btn sidebar-btn-active" />
                <Button text="Catégories" styleClass="sidebar-btn" />
            </VBox>
        </VBox>
    </left>
    <!-- Main Content -->
    <center>
        <VBox spacing="20" style="-fx-padding: 30;">
            <padding>
                <Insets top="30" right="30" bottom="30" left="30" />
            </padding>
            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label text="Gestion des Produits" styleClass="main-title" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="Nouveau Produit" styleClass="add-btn" fx:id="btnAjouter" onAction="#onAjouter" />
            </HBox>
            <!-- Filtres -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField promptText="Rechercher par nom ou ref..." fx:id="tfRechercheProduit" styleClass="search-field" />
                <ComboBox promptText="Toutes les catégories" fx:id="cbCategorieProduit" styleClass="filter-combo" />
                <ComboBox promptText="Trier par" fx:id="cbTriProduit" styleClass="filter-combo" />
                <ComboBox promptText="Ordre" fx:id="cbOrdreProduit" styleClass="filter-combo" />
                <Button text="Rechercher" styleClass="filter-btn" fx:id="btnRechercherProduit" onAction="#onRechercherProduit" />
                <Button text="Réinitialiser" styleClass="reset-btn" fx:id="btnResetProduit" onAction="#onResetRechercheProduit" />
            </HBox>
            <!-- Table -->
            <TableView fx:id="tableProduits" styleClass="product-table">
                <columns>
                    <TableColumn text="IMAGE" fx:id="colImage" />
                    <TableColumn text="NOM" fx:id="colNom" />
                    <TableColumn text="DESCRIPTION" fx:id="colDescription" />
                    <TableColumn text="PRIX" fx:id="colPrix" />
                    <TableColumn text="DATE EXPIRATION" fx:id="colDateExpiration" />
                    <TableColumn text="STATUT" fx:id="colStatut" />
                    <TableColumn text="QUANTITE" fx:id="colQuantite" />
                    <TableColumn text="CATEGORIE" fx:id="colCategorieId" />
                    <TableColumn text="ACTIONS" fx:id="colActions" />
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
