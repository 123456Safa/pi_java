<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.GestionCategorieController"
      stylesheets="@../pharmax-design-system.css"
      spacing="18" styleClass="crud-page">

    <!-- ═══ PAGE HEADER ═══ -->
    <VBox styleClass="crud-toolbar" spacing="4">
        <HBox alignment="CENTER_LEFT" spacing="20">
            <VBox spacing="4">
                <Label text="Gestion des Catégories" styleClass="crud-toolbar-title"/>
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <Label text="Tableau de bord / Catégories" styleClass="crud-toolbar-subtitle"/>
                </HBox>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="+ Nouvelle Catégorie" styleClass="action-button primary-action"
                    fx:id="btnAjouter" onAction="#onAjouter"/>
        </HBox>
    </VBox>

    <!-- ═══ CARD LISTE ═══ -->
    <VBox styleClass="table-card" spacing="16" VBox.vgrow="ALWAYS">

        <Label text="Liste des Catégories" styleClass="card-title"/>

        <!-- TABLEAU -->
        <TableView fx:id="tableCategories" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNom"         text="NOM"           prefWidth="200"/>
                <TableColumn fx:id="colDescription" text="DESCRIPTION"   prefWidth="320"/>
                <TableColumn fx:id="colCreatedAt"   text="DATE CRÉATION" prefWidth="160"/>
                <TableColumn fx:id="colActions"     text="ACTIONS"       prefWidth="220"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
        
        <!-- PAGINATION -->
        <HBox alignment="CENTER" style="-fx-padding: 10 0 0 0;">
            <Pagination fx:id="pagination" maxPageIndicatorCount="5" />
        </HBox>

    </VBox>

</VBox>

