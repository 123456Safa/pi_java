<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18" xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.OrdersManagementController"
      styleClass="crud-page">
    <VBox spacing="4" styleClass="crud-toolbar">
        <Label text="Page Commande" styleClass="crud-toolbar-title" />
        <Label text="Suivi des commandes, statuts, filtres et statistiques" styleClass="crud-toolbar-subtitle" />
    </VBox>

    <HBox spacing="18">
        <VBox spacing="8" styleClass="px-metric px-metric-amber" HBox.hgrow="ALWAYS">
            <Label text="En attente" styleClass="px-metric-label" />
            <Label fx:id="pendingStatLabel" text="0" styleClass="px-metric-value" />
        </VBox>
        <VBox spacing="8" styleClass="px-metric px-metric-indigo" HBox.hgrow="ALWAYS">
            <Label text="Confirmees" styleClass="px-metric-label" />
            <Label fx:id="confirmedStatLabel" text="0" styleClass="px-metric-value" />
        </VBox>
        <VBox spacing="8" styleClass="px-metric px-metric-emerald" HBox.hgrow="ALWAYS">
            <Label text="Livrees" styleClass="px-metric-label" />
            <Label fx:id="deliveredStatLabel" text="0" styleClass="px-metric-value" />
        </VBox>
        <VBox spacing="8" styleClass="px-metric px-metric-rose" HBox.hgrow="ALWAYS">
            <Label text="Annulees" styleClass="px-metric-label" />
            <Label fx:id="cancelledStatLabel" text="0" styleClass="px-metric-value" />
        </VBox>
    </HBox>

    <VBox spacing="6" styleClass="table-card">
        <Label text="Statistique des statuts" styleClass="card-title" />
        <Label fx:id="statusSummaryLabel" text="Aucune commande" styleClass="crud-toolbar-subtitle" />
    </VBox>

    <VBox spacing="14" styleClass="table-card" VBox.vgrow="ALWAYS">
        <HBox spacing="12" styleClass="filters-bar">
            <TextField fx:id="searchField" promptText="Rechercher par ID, statut, produits ou utilisateur" styleClass="text-field" HBox.hgrow="ALWAYS" />
            <ComboBox fx:id="statusFilterBox" promptText="Filtrer par statut" styleClass="status-combo" prefWidth="180" />
            <ComboBox fx:id="sortBox" promptText="Trier par" styleClass="status-combo" prefWidth="210" />
        </HBox>
        <Label fx:id="ordersCountLabel" text="0 commande" styleClass="card-title" />
        <TableView fx:id="ordersTable" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="50" minWidth="40" />
                <TableColumn fx:id="produitsColumn" text="Produits" prefWidth="200" minWidth="150" />
                <TableColumn fx:id="totalColumn" text="Total" prefWidth="90" minWidth="80" />
                <TableColumn fx:id="statutColumn" text="Statut" prefWidth="110" minWidth="100" />
                <TableColumn fx:id="createdAtColumn" text="Date" prefWidth="150" minWidth="140" />
                <TableColumn fx:id="utilisateurIdColumn" text="User ID" prefWidth="70" minWidth="60" />
                <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="280" minWidth="250" />
            </columns>
        </TableView>
        <HBox alignment="CENTER" style="-fx-padding: 10 0 0 0;">
            <Pagination fx:id="pagination" maxPageIndicatorCount="5" />
        </HBox>
    </VBox>
</VBox>
