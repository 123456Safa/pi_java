<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.SidebarController"
      styleClass="sidebar" prefWidth="220" spacing="0">

    <!-- ═══ LOGO ZONE ═══ -->
    <VBox styleClass="sidebar-logo-zone" alignment="CENTER" spacing="6">
        <ImageView fitWidth="90" fitHeight="32" preserveRatio="true">
            <image><Image url="@logo.png"/></image>
        </ImageView>
        <Label text="Pharmax" styleClass="sidebar-brand"/>
        <Label text="Back Office" styleClass="sidebar-brand-sub"/>
    </VBox>

    <!-- ═══ DIVIDER ═══ -->
    <HBox styleClass="sidebar-divider"/>

    <!-- ═══ MAIN MENU ═══ -->
    <VBox spacing="4" styleClass="sidebar-menu" VBox.vgrow="ALWAYS">

        <Label text="MENU PRINCIPAL" styleClass="sidebar-section-label"/>

        <Button text="🏠   Dashboard" styleClass="sidebar-btn"
                fx:id="btnDashboard" onAction="#onDashboard"
                maxWidth="1.7976931348623157E308"/>

        <Button text="📦   Produits" styleClass="sidebar-btn"
                fx:id="btnProduits" onAction="#onProduits"
                maxWidth="1.7976931348623157E308"/>

        <Button text="🗂   Catégories" styleClass="sidebar-btn"
                fx:id="btnCategories" onAction="#onCategories"
                maxWidth="1.7976931348623157E308"/>

        <!-- DIVIDER -->
        <HBox styleClass="sidebar-divider-thin"/>

        <Label text="FRONT OFFICE" styleClass="sidebar-section-label"/>

        <Button text="🛍   Voir Produits" styleClass="sidebar-btn-secondary"
                fx:id="btnVoirProduits" onAction="#onVoirProduits"
                maxWidth="1.7976931348623157E308"/>

    </VBox>

    <!-- ═══ FOOTER ═══ -->
    <VBox styleClass="sidebar-footer" alignment="CENTER" spacing="4">
        <HBox styleClass="sidebar-divider-thin"/>
        <Label text="© 2026 Pharmax" styleClass="sidebar-footer-label"/>
        <Label text="v1.0" styleClass="sidebar-version-label"/>
    </VBox>

</VBox>
