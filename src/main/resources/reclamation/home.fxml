<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Pagination?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.HomeReclamationController"
      stylesheets="@../pharmax-design-system.css"
      spacing="18"
      styleClass="crud-page">

    <!-- ═══ PAGE HEADER ═══ -->
    <VBox styleClass="crud-toolbar" spacing="4">
        <HBox alignment="CENTER_LEFT" spacing="20">
            <VBox spacing="4">
                <Label text="Centre d'Assistance &amp; Réclamations" styleClass="crud-toolbar-title"/>
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <Label text="Nous sommes là pour vous aider. Consultez et gérez vos demandes." styleClass="crud-toolbar-subtitle"/>
                </HBox>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="✨ Nouvelle Réclamation" onAction="#openAdd" styleClass="action-button primary-action" />
        </HBox>
    </VBox>

    <VBox spacing="14" styleClass="table-card" VBox.vgrow="ALWAYS">
        <Label text="Mes Réclamations" styleClass="card-title" />
        
        <!-- Pagination Container (which likely holds cards or a table dynamically injected by the controller) -->
        <VBox VBox.vgrow="ALWAYS" spacing="0">
            <Pagination fx:id="pagination" VBox.vgrow="ALWAYS" />
        </VBox>
    </VBox>

</VBox>