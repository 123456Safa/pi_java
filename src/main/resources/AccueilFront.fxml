<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AccueilFrontController" stylesheets="@AccueilFront.css" spacing="0" VBox.vgrow="ALWAYS">
    <VBox spacing="0" style="-fx-background-color: #ffffff;">

        <!-- En-tête principal PHARMAX -->
        <HBox style="-fx-background: linear-gradient(to right, #0f766e, #1a9999); -fx-padding: 30 30 20 30;" spacing="50" alignment="CENTER_LEFT">
            <VBox spacing="5">
                <Label text="PHARMAX" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #6366f1; -fx-text-fill: white;" />
                <Label text="Catalogue de produits pharmaceutiques" style="-fx-font-size: 12; -fx-text-fill: #17BD43;" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
        </HBox>

        <!-- Section de recherche et filtres -->
        <VBox style="-fx-background-color: #f5f5f5; -fx-padding: 20 30;" spacing="15">
            <Label text="Rechercher &amp; Filtrer" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1A17BD;" />

            <HBox spacing="15" alignment="CENTER_LEFT">
                <!-- Barre de recherche par nom -->
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Nom du produit" style="-fx-font-size: 11; -fx-text-fill: #10427E;" />
                    <TextField fx:id="searchNomField" promptText="Rechercher par nom..." style="-fx-padding: 8; -fx-font-size: 12;" />
                </VBox>

                <!-- Filtre par catégorie -->
                <VBox spacing="5">
                    <Label text="Catégorie" style="-fx-font-size: 11; -fx-text-fill: #10427E;" />
                    <ComboBox fx:id="categorieComboBox" promptText="Toutes les catégories" style="-fx-min-width: 180;" />
                </VBox>

                <!-- Filtre par prix minimum -->
                <VBox spacing="5">
                    <Label text="Prix min (DT)" style="-fx-font-size: 11; -fx-text-fill: #10427E;" />
                    <TextField fx:id="prixMinField" promptText="0" style="-fx-padding: 8; -fx-font-size: 12; -fx-pref-width: 120;" />
                </VBox>

                <!-- Filtre par prix maximum -->
                <VBox spacing="5">
                    <Label text="Prix max (DT)" style="-fx-font-size: 11; -fx-text-fill: #10427E;" />
                    <TextField fx:id="prixMaxField" promptText="10000" style="-fx-padding: 8; -fx-font-size: 12; -fx-pref-width: 120;" />
                </VBox>

                <!-- Boutons d'action -->
                <VBox spacing="5" alignment="BOTTOM_CENTER">
                    <HBox spacing="10">
                        <Button fx:id="btnRechercher" text="Rechercher" style="-fx-background-color: #1A17BD; -fx-text-fill: white; -fx-padding: 8 20; -fx-font-weight: bold; -fx-cursor: hand;" />
                        <Button fx:id="btnReinitialiser" text="Réinitialiser" style="-fx-background-color: #e0e0e0; -fx-text-fill: #333; -fx-padding: 8 20; -fx-font-weight: bold; -fx-cursor: hand;" />
                    </HBox>
                </VBox>
            </HBox>
        </VBox>

        <!-- Section promotion "Catalogue sante & bien-etre" -->
        <HBox style="-fx-background: linear-gradient(to right, #0f766e, #1a9999); -fx-padding: 20 30; -fx-margin: 0;" spacing="20">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Catalogue sante &amp; bien-etre" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;" />
                <Label text="Découvrez une sélection claire, moderne et accessible de produits pharmaceutiques." style="-fx-font-size: 12; -fx-text-fill: #e0e0e0;" wrapText="true" />
            </VBox>
        </HBox>
    </VBox>
    <ScrollPane fitToWidth="true" style="-fx-background: #fafafa;" VBox.vgrow="ALWAYS">
        <FlowPane fx:id="vboxProduitsAccueil" hgap="20" vgap="20" style="-fx-padding: 30 30 40 30; -fx-background-color: #fafafa;" alignment="TOP_LEFT" />
    </ScrollPane>
</VBox>
