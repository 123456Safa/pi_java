<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18" xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.frontoffice.HistoriqueController"
      styleClass="history-page">
    <Label text="Mes commandes" styleClass="hero-title" />
    <Label text="Consultez et recherchez les details de vos commandes" styleClass="hero-subtitle" />
    <HBox spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="searchField"
                   promptText="Rechercher par numero, statut, date, total ou produit"
                   styleClass="history-search"
                   HBox.hgrow="ALWAYS" />
        <Label fx:id="resultsLabel"
               text="0 commande"
               styleClass="history-results" />
    </HBox>

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="history-scroll">
        <content>
            <TilePane fx:id="commandesContainer" hgap="24" vgap="24" prefColumns="2" tileAlignment="TOP_LEFT">
                <padding>
                    <Insets top="8" right="8" bottom="8" left="8" />
                </padding>
            </TilePane>
        </content>
    </ScrollPane>
</VBox>
