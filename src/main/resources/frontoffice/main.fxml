<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>

<BorderPane fx:id="mainPane" xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.frontoffice.FrontOfficeMainController">
    <top>
        <HBox spacing="10" style="-fx-padding: 10; -fx-background-color: #2c3e50;" alignment="CENTER">
            <Button text="🛍️ Catalogue" onAction="#showCatalogue" style="-fx-font-size: 12; -fx-padding: 10px 20px; -fx-background-color: #27ae60; -fx-text-fill: white;"/>
            <Button text="🛒 Panier" onAction="#showPanier" style="-fx-font-size: 12; -fx-padding: 10px 20px; -fx-background-color: #e74c3c; -fx-text-fill: white;"/>
            <Button text="📜 Historique" onAction="#showHistorique" style="-fx-font-size: 12; -fx-padding: 10px 20px; -fx-background-color: #3498db; -fx-text-fill: white;"/>
        </HBox>
    </top>
    <center>
        <Label text="Bienvenue sur PHARMAX" style="-fx-font-size: 24; -fx-font-weight: bold;"/>
    </center>
</BorderPane>

