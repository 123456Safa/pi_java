<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox fx:controller="controllers.FormController"
      xmlns="http://javafx.com/javafx/20"
      xmlns:fx="http://javafx.com/fxml/1"
      prefWidth="640" prefHeight="400">

    <children>
        <AnchorPane prefWidth="640" prefHeight="400">

            <children>

                <Text layoutX="30" layoutY="80" text="Titre"/>
                <TextField fx:id="titre" layoutX="120" layoutY="60" prefWidth="400"/>

                <Text layoutX="30" layoutY="150" text="Description"/>
                <TextField fx:id="description" layoutX="120" layoutY="120" prefWidth="400"/>

                <Button layoutX="180" layoutY="300" text="Enregistrer"/>
                <Button layoutX="340" layoutY="300" text="Annuler"/>

            </children>

        </AnchorPane>
    </children>

</VBox>